# ============================================================
#  京华文考 · AI 引擎配置（二选一即可，复制本文件为 .env.local）
# ============================================================

# —— 方案 A：DeepSeek（推荐国内使用，走开发服务器代理，key 不进前端包）——
# 在 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=sk-your-deepseek-key
# 可选：模型（默认 deepseek-chat；也可用 deepseek-reasoner 深度推理）
# DEEPSEEK_MODEL=deepseek-chat
# 可选：自定义/中转网关地址（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# —— 方案 B：Google Gemini（SDK 直连）——
# GEMINI_API_KEY=your-gemini-key

# —— 可选：两个都配了时，强制指定用哪个（deepseek | gemini）——
# 不设置则自动优先 DeepSeek
# AI_PROVIDER=deepseek

# 注意：DeepSeek 依赖 Vite 开发代理，请用 `npm run dev` 启动（`npm run preview` 静态预览不支持 DeepSeek）
